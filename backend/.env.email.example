# Email Configuration

## SMTP Configuration
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your_username
EMAIL_PASSWORD=your_password
EMAIL_FROM=noreply@stellarcert.com

## OR SendGrid Configuration (instead of SMTP above)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@stellarcert.com

## Redis Configuration (required for email queue)
REDIS_URL=redis://localhost:6379

## Public app URL (used in email links, QR codes and PDFs).
## FRONTEND_URL is canonical; APP_URL is a deprecated alias kept for
## existing deployments. Must be reachable by recipients, no trailing slash.
FRONTEND_URL=https://stellarcert.com
# APP_URL=https://stellarcert.com
